# .gitignore for STM32CubeIDE / Eclipse projects
# Generated for the project at the workspace root
# Keep essential project sources (.ioc, .c/.h, linker scripts) tracked.

# Eclipse / STM32CubeIDE metadata
/.metadata/
/.settings/
.project
.cproject
*.launch
*.launches

# Workspace and IDE editors
.vscode/
.idea/
*.swp
*~

# Build output folders (STM32CubeIDE typically places build outputs in Debug/)
/Debug/
/Release/
/build/

# Compiled objects, maps, lists, temporary files
**/*.o
**/*.obj
**/*.su
**/*.d
**/*.map
**/*.list
**/*.elf
**/*.axf
**/*.bin
**/*.hex
**/*.lib
**/*.a

# Linker scripts or other generated files that you may want to keep
# (uncomment if you want to ignore .ld files)
# **/*.ld

# STM32CubeMX generated files - usually you WANT to keep the .ioc file
# (uncomment to ignore if you prefer not to track it)
# *.ioc

# Tool / temporary files
*.log
*.tmp
*.bak
Thumbs.db
.DS_Store

# Serial/temporary environment files
.env

# User-specific files
*.launch
*.user

# Optional: ignore build subfolders inside Core/Debug etc
Core/**/Debug/

# Ignore files generated by some toolchains
**/*.hex

# End of .gitignore
